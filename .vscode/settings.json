{
  // Lets the VS Code Java extension understand the backend sources
  // (classpath = the vendored jars in backend/lib).
  "java.project.sourcePaths": ["backend/src/main/java"],
  "java.project.referencedLibraries": ["backend/lib/**/*.jar"],
  // Don't index the runtime database files or compiled output.
  "files.exclude": {
    "backend/data/**": true,
    "backend/out/**": true
  }
}
